# InsightAI production environment (docs/DEPLOYMENT.md). Copy OUTSIDE the repository, e.g.
# /etc/insightai/production.env (chmod 600), fill every <...> value and pass it with
#   INSIGHTAI_ENV_FILE=/etc/insightai/production.env docker compose -f docker/compose.prod.yml \
#     --env-file /etc/insightai/production.env --profile selfhosted-db up -d
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# ── Edge ────────────────────────────────────────────────────────────────────────────────
# Public domain (automatic HTTPS) or ":80" when TLS ends at another proxy.
SITE_ADDRESS=analytics.example.vn
CORS_ORIGINS=

# ── API ─────────────────────────────────────────────────────────────────────────────────
PORT=3100
LOG_LEVEL=info
JWT_ACCESS_SECRET=<32+ random characters>

# ── PostgreSQL ──────────────────────────────────────────────────────────────────────────
# Self-hosted (profile selfhosted-db): superuser of the container, used only by the migrate job.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<random>
POSTGRES_DB=insightai
# Managed PostgreSQL: host instead of "postgres"; the admin URL needs CREATEROLE (see DEPLOYMENT.md).
DATABASE_ADMIN_URL=postgresql://postgres:<superuser password>@postgres:5432/insightai
DATABASE_MIGRATE_URL=postgresql://insightai_owner:<random>@postgres:5432/insightai?schema=app
DATABASE_URL=postgresql://insightai_app:<random>@postgres:5432/insightai
DATABASE_PROVISIONER_URL=postgresql://insightai_provisioner:<random>@postgres:5432/insightai
DATABASE_ANALYTICS_URL=postgresql://insightai_analytics:<random>@postgres:5432/insightai
DATABASE_INGEST_URL=postgresql://insightai_ingest:<random>@postgres:5432/insightai

# ── Redis (password required in production) ─────────────────────────────────────────────
REDIS_PASSWORD=<random>
REDIS_URL=redis://:<same REDIS_PASSWORD>@redis:6379

# ── Object storage (S3-compatible, provisioned outside the app) ─────────────────────────
S3_ENDPOINT=https://s3.example.vn
S3_REGION=<region>
S3_BUCKET=<bucket>
S3_ACCESS_KEY_ID=<key>
S3_SECRET_ACCESS_KEY=<secret>
S3_FORCE_PATH_STYLE=true

# ── AI (optional) ───────────────────────────────────────────────────────────────────────
# Organizations send only metadata to the provider unless an admin allows result samples.
# OPENAI_API_KEY=
# OPENAI_MODEL=
AI_DAILY_QUESTION_LIMIT=200
AI_ANSWER_TIMEOUT_MS=90000
AI_SSE_HEARTBEAT_MS=15000

# ── Backups (docker/backup/backup.sh) ───────────────────────────────────────────────────
BACKUP_ENCRYPTION_PASSPHRASE=<random, stored separately from the backups>
BACKUP_S3_BUCKET=<bucket in another region/provider>
# Investigations per user: per UTC day, and running at the same time.
# INVESTIGATION_DAILY_LIMIT=20
# INVESTIGATION_MAX_ACTIVE=2
