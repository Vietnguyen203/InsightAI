// Metadata plane (schema "app"). Data-plane tables (tenant schemas t_*) are NOT managed by Prisma.
// See docs/DATABASE_DESIGN.md. Row-Level Security policies live in the SQL migrations.
//
// Conventions: UUID v7 ids generated by the application (src/platform/ids), timestamptz(3),
// emails and slugs are stored lower-cased (normalised in the application).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ───────────────────────────── Core / IAM ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED

  @@schema("app")
}

enum MembershipStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  createdInvitations  Invitation[]   @relation("InvitationCreatedBy")
  acceptedInvitations Invitation[]   @relation("InvitationAcceptedBy")

  @@map("users")
  @@schema("app")
}

model Organization {
  id              String             @id @db.Uuid
  name            String
  slug            String             @unique
  /// Tenant data-plane schema, generated server-side (t_[a-z0-9]{10}). Never derived from input.
  dataSchema      String             @unique @map("data_schema")
  status          OrganizationStatus @default(PROVISIONING)
  timezone        String             @default("Asia/Ho_Chi_Minh")
  locale          String             @default("vi")
  defaultCurrency String             @default("VND") @map("default_currency")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  roles       Role[]
  invitations Invitation[]

  @@map("organizations")
  @@schema("app")
}

model Role {
  id             String   @id @db.Uuid
  /// NULL for built-in system roles shared by all organizations.
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId])
  @@map("roles")
  @@schema("app")
}

model Permission {
  code        String @id
  description String

  roles RolePermission[]

  @@map("permissions")
  @@schema("app")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("app")
}

model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  /// User attributes referenced by semantic-layer access policies (e.g. {"region": "North"}).
  attributes     Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("app")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId   String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("app")
}

model Invitation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  /// SHA-256 of the invitation token. The token is shown once, when the link is created.
  tokenHash      String    @unique @map("token_hash")
  createdById    String    @map("created_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedById   String?   @map("accepted_by") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  createdBy    User         @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("invitations")
  @@schema("app")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  /// NULL for user-level events that happen outside an organization (login, logout).
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  changes        Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
  @@schema("app")
}
