# Copy to .env for local development. Values below match docker/compose.yml and are for local use only.

NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# Superuser, used only by `pnpm db:bootstrap` to create roles. Never used by the running app.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:15432/insightai
# Schema owner: runs Prisma migrations.
DATABASE_MIGRATE_URL=postgresql://insightai_owner:owner_dev_pw@localhost:15432/insightai?schema=app
# Application role (metadata plane, subject to RLS).
DATABASE_URL=postgresql://insightai_app:app_dev_pw@localhost:15432/insightai
# Data plane pools (may only SET ROLE to tenant roles).
DATABASE_ANALYTICS_URL=postgresql://insightai_analytics:analytics_dev_pw@localhost:15432/insightai
DATABASE_INGEST_URL=postgresql://insightai_ingest:ingest_dev_pw@localhost:15432/insightai

REDIS_URL=redis://localhost:16379

S3_ENDPOINT=http://localhost:18333
S3_REGION=us-east-1
S3_BUCKET=insightai-dev
S3_ACCESS_KEY_ID=insightai-dev
S3_SECRET_ACCESS_KEY=insightai-dev-secret
S3_FORCE_PATH_STYLE=true
