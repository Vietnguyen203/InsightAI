// Metadata plane (schema "app"). Data-plane tables (tenant schemas t_*) are NOT managed by Prisma.
// See docs/DATABASE_DESIGN.md. Row-Level Security policies live in the SQL migrations.
//
// Conventions: UUID v7 ids generated by the application (src/platform/ids), timestamptz(3),
// emails and slugs are stored lower-cased (normalised in the application).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ───────────────────────────── Core / IAM ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED

  @@schema("app")
}

enum MembershipStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  createdInvitations  Invitation[]   @relation("InvitationCreatedBy")
  acceptedInvitations Invitation[]   @relation("InvitationAcceptedBy")

  @@map("users")
  @@schema("app")
}

model Organization {
  id              String             @id @db.Uuid
  name            String
  slug            String             @unique
  /// Tenant data-plane schema, generated server-side (t_[a-z0-9]{10}). Never derived from input.
  dataSchema      String             @unique @map("data_schema")
  status          OrganizationStatus @default(PROVISIONING)
  timezone        String             @default("Asia/Ho_Chi_Minh")
  locale          String             @default("vi")
  defaultCurrency String             @default("VND") @map("default_currency")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  roles       Role[]
  invitations Invitation[]
  dataSources DataSource[]
  datasets    Dataset[]

  @@map("organizations")
  @@schema("app")
}

model Role {
  id             String   @id @db.Uuid
  /// NULL for built-in system roles shared by all organizations.
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId])
  @@map("roles")
  @@schema("app")
}

model Permission {
  code        String @id
  description String

  roles RolePermission[]

  @@map("permissions")
  @@schema("app")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("app")
}

model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  /// User attributes referenced by semantic-layer access policies (e.g. {"region": "North"}).
  attributes     Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("app")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId   String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("app")
}

model Invitation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  /// SHA-256 of the invitation token. The token is shown once, when the link is created.
  tokenHash      String    @unique @map("token_hash")
  createdById    String    @map("created_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedById   String?   @map("accepted_by") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  createdBy    User         @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("invitations")
  @@schema("app")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  /// NULL for user-level events that happen outside an organization (login, logout).
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  changes        Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
  @@schema("app")
}

// ───────────────────────────── Data management ─────────────────────────────
// Child tables carry organization_id and reference their parent through a composite
// (organization_id, id) key, so the database itself rejects cross-tenant parent links.

enum DatasetStatus {
  /// Created, no successful import yet.
  DRAFT
  /// Has an active version that can be queried.
  READY
  ARCHIVED

  @@schema("app")
}

enum ImportJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("app")
}

enum DatasetVersionOrigin {
  IMPORT
  CLEANING

  @@schema("app")
}

enum ColumnDataType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  TIMESTAMP

  @@schema("app")
}

/// An uploaded file. Immutable: the stored object is never modified.
model DataSource {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  type             String   @default("FILE_UPLOAD")
  storageKey       String   @unique @map("storage_key")
  originalFilename String   @map("original_filename")
  /// csv | xlsx
  fileFormat       String   @map("file_format")
  sizeBytes        BigInt   @map("size_bytes")
  sha256           String
  uploadedById     String   @map("uploaded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  importJobs   ImportJob[]

  @@unique([organizationId, id])
  @@index([organizationId, sha256])
  @@map("data_sources")
  @@schema("app")
}

model Dataset {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  name            String
  description     String?
  /// Server-generated key naming the data-plane tables of this dataset ([a-z0-9]{10}).
  dataKey         String        @map("data_key")
  status          DatasetStatus @default(DRAFT)
  activeVersionId String?       @map("active_version_id") @db.Uuid
  createdById     String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)

  organization  Organization     @relation(fields: [organizationId], references: [id])
  versions      DatasetVersion[] @relation("DatasetVersions")
  activeVersion DatasetVersion?  @relation("ActiveVersion", fields: [organizationId, activeVersionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  importJobs    ImportJob[]

  @@unique([organizationId, id])
  @@unique([organizationId, dataKey])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("datasets")
  @@schema("app")
}

model DatasetVersion {
  id              String               @id @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  datasetId       String               @map("dataset_id") @db.Uuid
  versionNo       Int                  @map("version_no")
  origin          DatasetVersionOrigin
  parentVersionId String?              @map("parent_version_id") @db.Uuid
  importJobId     String?              @unique @map("import_job_id") @db.Uuid
  /// Typed table in the tenant schema (e.g. v_k3j9x0a1b2_3).
  physicalTable   String               @map("physical_table")
  /// Text-only copy of the imported values (validity checks, "original value" display).
  rawTable        String?              @map("raw_table")
  rowCount        BigInt               @map("row_count")
  createdById     String               @map("created_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  dataset   Dataset         @relation("DatasetVersions", fields: [organizationId, datasetId], references: [organizationId, id])
  activeOf  Dataset[]       @relation("ActiveVersion")
  importJob ImportJob?      @relation(fields: [importJobId], references: [id])
  columns   DatasetColumn[]

  @@unique([organizationId, id])
  @@unique([datasetId, versionNo])
  @@unique([organizationId, physicalTable])
  @@map("dataset_versions")
  @@schema("app")
}

model DatasetColumn {
  id               String         @id @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  datasetVersionId String         @map("dataset_version_id") @db.Uuid
  ordinal          Int
  /// Header text exactly as in the file.
  originalName     String         @map("original_name")
  /// Normalized and unique within the version; stable across versions for rules and semantics.
  name             String
  /// Column identifier in the data-plane table (c_<ordinal>); never derived from file content.
  physicalName     String         @map("physical_name")
  dataType         ColumnDataType @map("data_type")
  inferredType     ColumnDataType @map("inferred_type")
  /// Share of non-empty values that match the chosen type (0..1).
  typeConfidence   Decimal        @map("type_confidence") @db.Decimal(5, 4)
  detectedFormat   String?        @map("detected_format")
  nonEmptyCount    BigInt         @map("non_empty_count")
  /// Non-empty raw values that could not be converted to the column type (stored as NULL).
  invalidCount     BigInt         @map("invalid_count")

  version DatasetVersion @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([datasetVersionId, name])
  @@unique([datasetVersionId, ordinal])
  @@map("dataset_columns")
  @@schema("app")
}

model ImportJob {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  datasetId      String          @map("dataset_id") @db.Uuid
  dataSourceId   String          @map("data_source_id") @db.Uuid
  status         ImportJobStatus @default(PENDING)
  /// Parsing options as requested (delimiter, encoding, locale, sheet, column type overrides).
  options        Json            @default("{}")
  /// Server-generated suffix of the tables this job creates; lets a retry drop its own leftovers.
  tableKey       String          @map("table_key")
  attempts       Int             @default(0)
  rowsRead       BigInt?         @map("rows_read")
  /// Non-fatal findings (ragged rows, renamed headers, ...).
  warnings       Json            @default("[]")
  /// { code, message } when FAILED. Never contains stack traces.
  error          Json?
  requestedById  String          @map("requested_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(3)

  dataset    Dataset         @relation(fields: [organizationId, datasetId], references: [organizationId, id])
  dataSource DataSource      @relation(fields: [organizationId, dataSourceId], references: [organizationId, id])
  version    DatasetVersion?

  @@unique([organizationId, id])
  @@index([organizationId, datasetId, createdAt(sort: Desc)])
  @@map("import_jobs")
  @@schema("app")
}
