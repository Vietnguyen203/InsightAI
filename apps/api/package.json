{
  "name": "@insightai/api",
  "version": "0.1.0",
  "private": true,
  "description": "InsightAI backend: NestJS modular monolith (api + worker entrypoints)",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:bootstrap": "node --env-file-if-exists=../../.env scripts/bootstrap-db.mjs",
    "storage:bootstrap": "node --env-file-if-exists=../../.env scripts/ensure-bucket.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@insightai/contracts": "workspace:*",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "helmet": "8.3.0",
    "iconv-lite": "0.7.3",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "libpg-query": "18.1.5",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sax": "1.6.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/sax": "1.2.7",
    "@types/supertest": "6.0.3",
    "@types/yauzl": "3.4.0",
    "exceljs": "4.4.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  }
}
