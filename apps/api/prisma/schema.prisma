// Metadata plane (schema "app"). Data-plane tables (tenant schemas t_*) are NOT managed by Prisma.
// See docs/DATABASE_DESIGN.md. Row-Level Security policies live in the SQL migrations.
//
// Conventions: UUID v7 ids generated by the application (src/platform/ids), timestamptz(3),
// emails and slugs are stored lower-cased (normalised in the application).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ───────────────────────────── Core / IAM ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED

  @@schema("app")
}

enum MembershipStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  createdInvitations  Invitation[]   @relation("InvitationCreatedBy")
  acceptedInvitations Invitation[]   @relation("InvitationAcceptedBy")

  @@map("users")
  @@schema("app")
}

model Organization {
  id              String             @id @db.Uuid
  name            String
  slug            String             @unique
  /// Tenant data-plane schema, generated server-side (t_[a-z0-9]{10}). Never derived from input.
  dataSchema      String             @unique @map("data_schema")
  status          OrganizationStatus @default(PROVISIONING)
  timezone        String             @default("Asia/Ho_Chi_Minh")
  locale          String             @default("vi")
  defaultCurrency String             @default("VND") @map("default_currency")
  /// What the AI provider may receive (D-50): METADATA_ONLY (default) or FULL (result samples).
  aiDataSharing   AiDataSharing      @default(METADATA_ONLY) @map("ai_data_sharing")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    Membership[]
  roles          Role[]
  invitations    Invitation[]
  dataSources    DataSource[]
  datasets       Dataset[]
  semanticModels SemanticModel[]
  dashboards     Dashboard[]

  @@map("organizations")
  @@schema("app")
}

model Role {
  id             String   @id @db.Uuid
  /// NULL for built-in system roles shared by all organizations.
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId])
  @@map("roles")
  @@schema("app")
}

model Permission {
  code        String @id
  description String

  roles RolePermission[]

  @@map("permissions")
  @@schema("app")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("app")
}

model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  /// User attributes referenced by semantic-layer access policies (e.g. {"region": "North"}).
  attributes     Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("app")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId   String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("app")
}

model Invitation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  /// SHA-256 of the invitation token. The token is shown once, when the link is created.
  tokenHash      String    @unique @map("token_hash")
  createdById    String    @map("created_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedById   String?   @map("accepted_by") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  createdBy    User         @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("invitations")
  @@schema("app")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  /// NULL for user-level events that happen outside an organization (login, logout).
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  changes        Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
  @@schema("app")
}

// ───────────────────────────── Data management ─────────────────────────────
// Child tables carry organization_id and reference their parent through a composite
// (organization_id, id) key, so the database itself rejects cross-tenant parent links.

enum DatasetStatus {
  /// Created, no successful import yet.
  DRAFT
  /// Has an active version that can be queried.
  READY
  ARCHIVED

  @@schema("app")
}

enum ImportJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("app")
}

enum DatasetVersionOrigin {
  IMPORT
  CLEANING

  @@schema("app")
}

enum ColumnDataType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  TIMESTAMP

  @@schema("app")
}

/// An uploaded file. Immutable: the stored object is never modified.
model DataSource {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  type             String   @default("FILE_UPLOAD")
  storageKey       String   @unique @map("storage_key")
  originalFilename String   @map("original_filename")
  /// csv | xlsx
  fileFormat       String   @map("file_format")
  sizeBytes        BigInt   @map("size_bytes")
  sha256           String
  uploadedById     String   @map("uploaded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  importJobs   ImportJob[]

  @@unique([organizationId, id])
  @@index([organizationId, sha256])
  @@map("data_sources")
  @@schema("app")
}

model Dataset {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  name            String
  description     String?
  /// Server-generated key naming the data-plane tables of this dataset ([a-z0-9]{10}).
  dataKey         String        @map("data_key")
  status          DatasetStatus @default(DRAFT)
  activeVersionId String?       @map("active_version_id") @db.Uuid
  createdById     String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  versions         DatasetVersion[] @relation("DatasetVersions")
  activeVersion    DatasetVersion?  @relation("ActiveVersion", fields: [organizationId, activeVersionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  importJobs       ImportJob[]
  qualityRules     QualityRule[]
  qualityChecks    QualityCheck[]
  cleaningJobs     CleaningJob[]
  semanticEntities SemanticEntity[]

  @@unique([organizationId, id])
  @@unique([organizationId, dataKey])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("datasets")
  @@schema("app")
}

model DatasetVersion {
  id              String               @id @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  datasetId       String               @map("dataset_id") @db.Uuid
  versionNo       Int                  @map("version_no")
  origin          DatasetVersionOrigin
  parentVersionId String?              @map("parent_version_id") @db.Uuid
  importJobId     String?              @unique @map("import_job_id") @db.Uuid
  cleaningJobId   String?              @unique @map("cleaning_job_id") @db.Uuid
  /// Typed table in the tenant schema (e.g. v_k3j9x0a1b2_3).
  physicalTable   String               @map("physical_table")
  /// Text-only copy of the imported values (validity checks, "original value" display).
  rawTable        String?              @map("raw_table")
  rowCount        BigInt               @map("row_count")
  /// Column statistics computed after import (docs/DATA_QUALITY_DESIGN.md §7).
  profileStatus   ProfileStatus        @default(PENDING) @map("profile_status")
  profiledAt      DateTime?            @map("profiled_at") @db.Timestamptz(3)
  /// Result of the latest successful quality check of this version.
  qualityStatus   QualityStatus        @default(UNCHECKED) @map("quality_status")
  qualityScore    Decimal?             @map("quality_score") @db.Decimal(5, 2)
  createdById     String               @map("created_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  dataset       Dataset         @relation("DatasetVersions", fields: [organizationId, datasetId], references: [organizationId, id])
  activeOf      Dataset[]       @relation("ActiveVersion")
  importJob     ImportJob?      @relation(fields: [importJobId], references: [id])
  cleaningJob   CleaningJob?    @relation("CleaningTarget", fields: [cleaningJobId], references: [id])
  cleaningRuns  CleaningJob[]   @relation("CleaningSource")
  columns       DatasetColumn[]
  profiles      ColumnProfile[]
  qualityChecks QualityCheck[]

  @@unique([organizationId, id])
  @@unique([datasetId, versionNo])
  @@unique([organizationId, physicalTable])
  @@map("dataset_versions")
  @@schema("app")
}

model DatasetColumn {
  id               String         @id @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  datasetVersionId String         @map("dataset_version_id") @db.Uuid
  ordinal          Int
  /// Header text exactly as in the file.
  originalName     String         @map("original_name")
  /// Normalized and unique within the version; stable across versions for rules and semantics.
  name             String
  /// Column identifier in the data-plane table (c_<ordinal>); never derived from file content.
  physicalName     String         @map("physical_name")
  dataType         ColumnDataType @map("data_type")
  inferredType     ColumnDataType @map("inferred_type")
  /// Share of non-empty values that match the chosen type (0..1).
  typeConfidence   Decimal        @map("type_confidence") @db.Decimal(5, 4)
  detectedFormat   String?        @map("detected_format")
  nonEmptyCount    BigInt         @map("non_empty_count")
  /// Non-empty raw values that could not be converted to the column type (stored as NULL).
  invalidCount     BigInt         @map("invalid_count")

  version DatasetVersion @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Cascade)
  profile ColumnProfile?

  @@unique([datasetVersionId, name])
  @@unique([organizationId, id])
  @@unique([datasetVersionId, ordinal])
  @@map("dataset_columns")
  @@schema("app")
}

model ImportJob {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  datasetId      String          @map("dataset_id") @db.Uuid
  dataSourceId   String          @map("data_source_id") @db.Uuid
  status         ImportJobStatus @default(PENDING)
  /// Parsing options as requested (delimiter, encoding, locale, sheet, column type overrides).
  options        Json            @default("{}")
  /// Server-generated suffix of the tables this job creates; lets a retry drop its own leftovers.
  tableKey       String          @map("table_key")
  attempts       Int             @default(0)
  rowsRead       BigInt?         @map("rows_read")
  /// Non-fatal findings (ragged rows, renamed headers, ...).
  warnings       Json            @default("[]")
  /// { code, message } when FAILED. Never contains stack traces.
  error          Json?
  requestedById  String          @map("requested_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(3)

  dataset    Dataset         @relation(fields: [organizationId, datasetId], references: [organizationId, id])
  dataSource DataSource      @relation(fields: [organizationId, dataSourceId], references: [organizationId, id])
  version    DatasetVersion?

  @@unique([organizationId, id])
  @@index([organizationId, datasetId, createdAt(sort: Desc)])
  @@map("import_jobs")
  @@schema("app")
}

enum ProfileStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("app")
}

/// Derived statistics for one column of one version. Recomputable at any time (not source data).
model ColumnProfile {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  datasetVersionId String   @map("dataset_version_id") @db.Uuid
  datasetColumnId  String   @unique @map("dataset_column_id") @db.Uuid
  /// Shape: ColumnProfile in @insightai/contracts (dataset.ts). Numbers are exact decimal strings.
  stats            Json
  /// True when distinct counts, percentiles and top values were computed on a sample.
  approximate      Boolean  @default(false)
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  version DatasetVersion @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Cascade)
  column  DatasetColumn  @relation(fields: [organizationId, datasetColumnId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, datasetColumnId])
  @@index([datasetVersionId])
  @@map("column_profiles")
  @@schema("app")
}

// ───────────────────────────── Data quality ─────────────────────────────
// docs/DATA_QUALITY_DESIGN.md §4–5. Rules belong to a dataset (apply to every version);
// checks evaluate one version. Results keep a snapshot of the rule as it was when evaluated.

enum QualitySeverity {
  info
  warning
  error

  @@schema("app")
}

enum QualityCheckStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("app")
}

enum QualityCheckTrigger {
  IMPORT
  MANUAL
  CLEANING

  @@schema("app")
}

enum QualityStatus {
  UNCHECKED
  PASSED
  WARNING
  FAILED

  @@schema("app")
}

enum RuleResultStatus {
  PASSED
  FAILED
  SKIPPED
  ERROR

  @@schema("app")
}

model QualityRule {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  datasetId      String          @map("dataset_id") @db.Uuid
  name           String
  /// completeness | uniqueness | validity | consistency | referential_integrity
  dimension      String
  /// RuleDefinition from @insightai/contracts (discriminated by `type`).
  definition     Json
  ruleType       String          @map("rule_type")
  severity       QualitySeverity @default(warning)
  weight         Int             @default(1)
  threshold      Decimal         @default(1) @db.Decimal(5, 4)
  enabled        Boolean         @default(true)
  /// system | user
  origin         String
  /// Identifies auto-created rules (e.g. "type_castable:ngay_dat") so they are created once.
  systemKey      String?         @map("system_key")
  createdById    String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  dataset Dataset              @relation(fields: [organizationId, datasetId], references: [organizationId, id])
  results QualityCheckResult[]

  @@unique([organizationId, id])
  @@unique([datasetId, systemKey])
  @@index([organizationId, datasetId])
  @@map("quality_rules")
  @@schema("app")
}

model QualityCheck {
  id               String              @id @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  datasetId        String              @map("dataset_id") @db.Uuid
  datasetVersionId String              @map("dataset_version_id") @db.Uuid
  trigger          QualityCheckTrigger
  status           QualityCheckStatus  @default(PENDING)
  /// 0–100, set when the check succeeded.
  score            Decimal?            @db.Decimal(5, 2)
  qualityStatus    QualityStatus       @default(UNCHECKED) @map("quality_status")
  dimensionScores  Json                @default("{}") @map("dimension_scores")
  rulesTotal       Int                 @default(0) @map("rules_total")
  rulesFailed      Int                 @default(0) @map("rules_failed")
  /// { code, message } when FAILED.
  error            Json?
  requestedById    String?             @map("requested_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?           @map("finished_at") @db.Timestamptz(3)

  dataset Dataset              @relation(fields: [organizationId, datasetId], references: [organizationId, id])
  version DatasetVersion       @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id])
  results QualityCheckResult[]

  @@unique([organizationId, id])
  @@index([organizationId, datasetId, createdAt(sort: Desc)])
  @@index([datasetVersionId])
  @@map("quality_checks")
  @@schema("app")
}

model QualityCheckResult {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  qualityCheckId String           @map("quality_check_id") @db.Uuid
  /// NULL when the rule was deleted after the check (the snapshot remains).
  qualityRuleId  String?          @map("quality_rule_id") @db.Uuid
  ruleSnapshot   Json             @map("rule_snapshot")
  status         RuleResultStatus
  evaluatedCount BigInt           @default(0) @map("evaluated_count")
  failedCount    BigInt           @default(0) @map("failed_count")
  passRate       Decimal?         @map("pass_rate") @db.Decimal(7, 6)
  message        String?
  sampleCount    Int              @default(0) @map("sample_count")

  check  QualityCheck   @relation(fields: [organizationId, qualityCheckId], references: [organizationId, id], onDelete: Cascade)
  rule   QualityRule?   @relation(fields: [qualityRuleId], references: [id], onDelete: SetNull)
  issues QualityIssue[]

  @@unique([organizationId, id])
  @@index([qualityCheckId])
  @@map("quality_check_results")
  @@schema("app")
}

/// Sample of failing rows (≤ 100 per rule and check), not every failing row (decision D-12).
model QualityIssue {
  id                   BigInt  @id @default(autoincrement())
  organizationId       String  @map("organization_id") @db.Uuid
  qualityCheckResultId String  @map("quality_check_result_id") @db.Uuid
  rowId                BigInt  @map("row_id")
  columnName           String? @map("column_name")
  value                String?
  rawValue             String? @map("raw_value")

  result QualityCheckResult @relation(fields: [organizationId, qualityCheckResultId], references: [organizationId, id], onDelete: Cascade)

  @@index([qualityCheckResultId, rowId])
  @@map("quality_issues")
  @@schema("app")
}

// ───────────────────────────── Cleaning ─────────────────────────────
// docs/DATA_QUALITY_DESIGN.md §6. A job applies an ordered, immutable list of operations to a
// source version and produces a new version (never modifies the source).

enum CleaningJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("app")
}

model CleaningJob {
  id              String            @id @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  datasetId       String            @map("dataset_id") @db.Uuid
  sourceVersionId String            @map("source_version_id") @db.Uuid
  status          CleaningJobStatus @default(PENDING)
  /// Server-generated suffix of the table this job creates; lets a retry drop its own leftovers.
  tableKey        String            @map("table_key")
  attempts        Int               @default(0)
  /// { code, message } when FAILED. Never contains SQL or stack traces.
  error           Json?
  requestedById   String?           @map("requested_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?         @map("finished_at") @db.Timestamptz(3)

  dataset       Dataset             @relation(fields: [organizationId, datasetId], references: [organizationId, id])
  sourceVersion DatasetVersion      @relation("CleaningSource", fields: [organizationId, sourceVersionId], references: [organizationId, id])
  targetVersion DatasetVersion?     @relation("CleaningTarget")
  operations    CleaningOperation[]

  @@unique([organizationId, id])
  @@index([organizationId, datasetId, createdAt(sort: Desc)])
  @@map("cleaning_jobs")
  @@schema("app")
}

model CleaningOperation {
  id             String  @id @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  cleaningJobId  String  @map("cleaning_job_id") @db.Uuid
  seq            Int
  opType         String  @map("op_type")
  /// CleaningOperation from @insightai/contracts (discriminated by `type`), as requested.
  params         Json
  /// Filled when the job succeeded (rows changed / removed by this operation).
  affectedRows   BigInt? @map("affected_rows")
  removedRows    BigInt? @map("removed_rows")

  job CleaningJob @relation(fields: [organizationId, cleaningJobId], references: [organizationId, id], onDelete: Cascade)

  @@unique([cleaningJobId, seq])
  @@map("cleaning_operations")
  @@schema("app")
}

// ───────────────────────────── Semantic layer ─────────────────────────────
// docs/SEMANTIC_LAYER_DESIGN.md §3, §7. Members are edited in a draft; publishing validates the
// model and stores an immutable snapshot (`published_snapshot`) that the query engine uses.

enum SemanticModelStatus {
  DRAFT
  PUBLISHED

  @@schema("app")
}

enum SemanticValidationStatus {
  UNVALIDATED
  VALID
  WARNING
  INVALID

  @@schema("app")
}

enum DimensionType {
  CATEGORICAL
  TIME

  @@schema("app")
}

enum RelationshipCardinality {
  MANY_TO_ONE
  ONE_TO_ONE

  @@schema("app")
}

model SemanticModel {
  id                String                   @id @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  key               String
  name              String
  description       String?
  status            SemanticModelStatus      @default(DRAFT)
  /// True when the draft differs from the published snapshot.
  hasDraftChanges   Boolean                  @default(true) @map("has_draft_changes")
  validationStatus  SemanticValidationStatus @default(UNVALIDATED) @map("validation_status")
  /// SemanticValidationReport from @insightai/contracts (latest validation of the draft).
  validationReport  Json?                    @map("validation_report")
  /// Published revision (0 = never published).
  revision          Int                      @default(0)
  /// Immutable copy of the model as published; the query engine reads only this.
  publishedSnapshot Json?                    @map("published_snapshot")
  publishedAt       DateTime?                @map("published_at") @db.Timestamptz(3)
  publishedById     String?                  @map("published_by") @db.Uuid
  createdById       String                   @map("created_by") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization           @relation(fields: [organizationId], references: [id])
  entities       SemanticEntity[]
  relationships  SemanticRelationship[]
  accessPolicies SemanticAccessPolicy[]
  metrics        Metric[]
  synonyms       SemanticSynonym[]
  conversations  Conversation[]
  investigations Investigation[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("semantic_models")
  @@schema("app")
}

model SemanticEntity {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  semanticModelId String   @map("semantic_model_id") @db.Uuid
  key             String
  name            String
  description     String?
  /// Source dataset; queries always use its active version.
  datasetId       String   @map("dataset_id") @db.Uuid
  /// Column names identifying one row (the entity grain).
  primaryKey      String[] @map("primary_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  model         SemanticModel          @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)
  dataset       Dataset                @relation(fields: [organizationId, datasetId], references: [organizationId, id])
  dimensions    SemanticDimension[]
  measures      SemanticMeasure[]
  relationsFrom SemanticRelationship[] @relation("RelationshipFrom")
  relationsTo   SemanticRelationship[] @relation("RelationshipTo")

  @@unique([organizationId, id])
  @@unique([semanticModelId, key])
  @@map("semantic_entities")
  @@schema("app")
}

model SemanticDimension {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  entityId       String        @map("entity_id") @db.Uuid
  key            String
  name           String
  description    String?
  type           DimensionType
  /// Expression DSL over the entity's columns.
  expr           String
  granularities  String[]
  hidden         Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity SemanticEntity @relation(fields: [organizationId, entityId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([entityId, key])
  @@map("semantic_dimensions")
  @@schema("app")
}

model SemanticMeasure {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  key            String
  name           String
  description    String?
  /// sum | count | count_distinct | avg | min | max
  agg            String
  /// Expression DSL over the entity's columns; NULL only for count (rows).
  expr           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity SemanticEntity @relation(fields: [organizationId, entityId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([entityId, key])
  @@map("semantic_measures")
  @@schema("app")
}

model SemanticRelationship {
  id              String                  @id @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  semanticModelId String                  @map("semantic_model_id") @db.Uuid
  fromEntityId    String                  @map("from_entity_id") @db.Uuid
  toEntityId      String                  @map("to_entity_id") @db.Uuid
  /// [{ from, to }] column pairs (from = "many" side).
  joinColumns     Json                    @map("join_columns")
  cardinality     RelationshipCardinality
  preferred       Boolean                 @default(false)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  model      SemanticModel  @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)
  fromEntity SemanticEntity @relation("RelationshipFrom", fields: [organizationId, fromEntityId], references: [organizationId, id], onDelete: Cascade)
  toEntity   SemanticEntity @relation("RelationshipTo", fields: [organizationId, toEntityId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([semanticModelId])
  @@map("semantic_relationships")
  @@schema("app")
}

/// Role-based restrictions on a model (docs/SEMANTIC_LAYER_DESIGN.md §8). Unlike members they take
/// effect immediately (no publish step): they are security rules, not definitions.
model SemanticAccessPolicy {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  semanticModelId String   @map("semantic_model_id") @db.Uuid
  name            String
  /// System role keys (owner, admin, analyst, viewer).
  roles           String[]
  /// { include?: string[], exclude?: string[] } member patterns ("entity.*", "entity.member").
  memberAccess    Json?    @map("member_access")
  /// { entity, expr } – Expression DSL the role's rows must satisfy.
  rowFilter       Json?    @map("row_filter")
  enabled         Boolean  @default(true)
  createdById     String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  model SemanticModel @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([semanticModelId, name])
  @@map("semantic_access_policies")
  @@schema("app")
}

enum QueryStatus {
  SUCCEEDED
  REJECTED
  FAILED

  @@schema("app")
}

/// One row per semantic query (who asked what, which definitions and data answered). Evidence:
/// the application can insert but not change or delete rows.
model QueryHistory {
  id                String      @id @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  /// API | KPI | DASHBOARD | AI
  source            String
  semanticModelId   String?     @map("semantic_model_id") @db.Uuid
  modelRevision     Int?        @map("model_revision")
  semanticQuery     Json        @map("semantic_query")
  compiledSql       String?     @map("compiled_sql")
  datasetVersionIds String[]    @map("dataset_version_ids")
  policiesApplied   String[]    @map("policies_applied")
  status            QueryStatus
  errorCode         String?     @map("error_code")
  rowCount          Int?        @map("row_count")
  truncated         Boolean     @default(false)
  cached            Boolean     @default(false)
  metricVersionIds  String[]    @map("metric_version_ids")
  durationMs        Int         @map("duration_ms")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("query_history")
  @@schema("app")
}

enum MetricStatus {
  ACTIVE
  DEPRECATED

  @@schema("app")
}

enum MetricVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED

  @@schema("app")
}

/// Stable identity of a business metric (key used by queries); definitions live in versions.
model Metric {
  id              String       @id @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  semanticModelId String       @map("semantic_model_id") @db.Uuid
  key             String
  status          MetricStatus @default(ACTIVE)
  createdById     String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  model    SemanticModel   @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)
  versions MetricVersion[]

  @@unique([organizationId, id])
  @@unique([semanticModelId, key])
  @@map("metrics")
  @@schema("app")
}

/// Immutable once published (trigger): only the status may change afterwards.
model MetricVersion {
  id                 String              @id @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  metricId           String              @map("metric_id") @db.Uuid
  versionNo          Int                 @map("version_no")
  status             MetricVersionStatus @default(DRAFT)
  /// SIMPLE | RATIO | DERIVED
  type               String
  /// MetricDefinition from @insightai/contracts.
  definition         Json
  label              String
  businessDefinition String?             @map("business_definition")
  unit               String?
  /// number | currency | percent
  format             String              @default("number")
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(3)
  publishedById      String?             @map("published_by") @db.Uuid
  createdById        String              @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  metric Metric @relation(fields: [organizationId, metricId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([metricId, versionNo])
  @@map("metric_versions")
  @@schema("app")
}

/// Phrases users say for a member ("doanh số" → total_revenue). One phrase points to one member.
model SemanticSynonym {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  semanticModelId  String   @map("semantic_model_id") @db.Uuid
  /// METRIC | DIMENSION
  memberKind       String   @map("member_kind")
  /// Metric key or `entity.dimension`.
  member           String
  phrase           String
  /// Lower case, accents removed (đ → d): the lookup key.
  phraseNormalized String   @map("phrase_normalized")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  model SemanticModel @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([semanticModelId, phraseNormalized])
  @@map("semantic_synonyms")
  @@schema("app")
}

// ───────────────────────────── AI analytics ─────────────────────────────
// docs/ARCHITECTURE.md §4.3. A conversation belongs to one user and one semantic model.

model Conversation {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  semanticModelId String   @map("semantic_model_id") @db.Uuid
  title           String
  lastMessageAt   DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  model    SemanticModel @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)
  messages Message[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
  @@schema("app")
}

enum MessageRole {
  USER
  ASSISTANT

  @@schema("app")
}

model Message {
  id             String      @id @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  /// Answer from @insightai/contracts (assistant messages): status, query, result, chart, …
  payload        Json?
  queryHistoryId String?     @map("query_history_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("app")
}

/// Tokens used per LLM call (cost tracking and quotas).
model LlmUsage {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  provider         String
  model            String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("llm_usage")
  @@schema("app")
}

enum DashboardVisibility {
  PRIVATE
  ORG

  @@schema("app")
}

/// Phase 6a: dashboards. PRIVATE ones are visible to their owner only (RLS on app.user_id).
model Dashboard {
  id             String              @id @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  ownerId        String              @map("owner_id") @db.Uuid
  name           String
  description    String?
  visibility     DashboardVisibility @default(PRIVATE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets      DashboardWidget[]

  @@unique([organizationId, id])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("dashboards")
  @@schema("app")
}

/// Stores the Semantic Query IR (never SQL or results); runs with the viewer's permissions.
model DashboardWidget {
  id                  String   @id @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  dashboardId         String   @map("dashboard_id") @db.Uuid
  title               String
  semanticQuery       Json     @map("semantic_query")
  chartSpec           Json     @map("chart_spec")
  position            Json
  sourceMessageId     String?  @map("source_message_id") @db.Uuid
  savedModelRevision  Int      @map("saved_model_revision")
  savedMetricVersions Json     @map("saved_metric_versions")
  createdBy           String   @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  dashboard Dashboard @relation(fields: [organizationId, dashboardId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([dashboardId])
  @@map("dashboard_widgets")
  @@schema("app")
}

enum AiDataSharing {
  METADATA_ONLY
  FULL

  @@schema("app")
}

enum InvestigationStatus {
  QUEUED
  PLANNING
  AWAITING_APPROVAL
  RUNNING
  VALIDATING
  REPORTING
  COMPLETED
  PARTIAL
  CANCELLED
  FAILED

  @@schema("app")
}

enum InvestigationStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED

  @@schema("app")
}

/// Phase 6C: a multi-step investigation (D-52). Private to its author (RLS on app.user_id).
model Investigation {
  id              String              @id @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  semanticModelId String              @map("semantic_model_id") @db.Uuid
  goal            String
  status          InvestigationStatus @default(QUEUED)
  requireApproval Boolean             @default(false) @map("require_approval")
  /// Analysis Plan IR after validation.
  plan            Json?
  /// Model revision and metric versions the run is pinned to (never remapped later).
  pinned          Json?
  budget          Json
  usage           Json
  cancelRequested Boolean             @default(false) @map("cancel_requested")
  errorCode       String?             @map("error_code")
  errorMessage    String?             @map("error_message")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?           @map("finished_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  model  SemanticModel        @relation(fields: [organizationId, semanticModelId], references: [organizationId, id], onDelete: Cascade)
  steps  InvestigationStep[]
  events InvestigationEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("investigations")
  @@schema("app")
}

model InvestigationStep {
  id              String                  @id @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  investigationId String                  @map("investigation_id") @db.Uuid
  stepKey         String                  @map("step_key")
  position        Int
  tool            String
  purpose         String
  status          InvestigationStepStatus @default(PENDING)
  attempt         Int                     @default(0)
  /// Tool input after resolving references to earlier steps.
  input           Json?
  output          Json?
  queryHistoryIds String[]                @map("query_history_ids") @db.Uuid
  errorCode       String?                 @map("error_code")
  startedAt       DateTime?               @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?               @map("finished_at") @db.Timestamptz(3)

  investigation Investigation @relation(fields: [organizationId, investigationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([investigationId, stepKey])
  @@map("investigation_steps")
  @@schema("app")
}

/// Append-only progress log, replayed to SSE clients (Last-Event-ID = seq).
model InvestigationEvent {
  seq             BigInt   @id @default(autoincrement())
  organizationId  String   @map("organization_id") @db.Uuid
  investigationId String   @map("investigation_id") @db.Uuid
  type            String
  data            Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  investigation Investigation @relation(fields: [organizationId, investigationId], references: [organizationId, id], onDelete: Cascade)

  @@index([investigationId, seq])
  @@map("investigation_events")
  @@schema("app")
}
